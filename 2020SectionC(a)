#Prompt the user to enter a password and store to...
#value entered in the variable password
password = input("Enter a password: ")
print("Password:", password)

#A variable to store all the lowercase letters in the alphabet
LOWER_CASE_LETTERS = "abcdefghijklmnopqrstuvwxyz"
UPPER_CASE_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" #(iii)
DIGITS = "0123456789" #(v)

#The variable lowercase and uppercase indicate the presence or ...
#absence of lowercase and uppercase characters in the password
lowercase = False
uppercase = False
digit = False #(v)

#Loop through each character in the password and ...
#check the password for specific characters
for i in password:
    if i in LOWER_CASE_LETTERS:
        lowercase = True
    if i in UPPER_CASE_LETTERS: #(iii)
        uppercase = True
    if i in DIGITS: #(v)
        digit = True
        
#Calculate the score based on the rules
#Initialise score (i)      
score = 0

#Rule 1
if len(password) > 7:
    score = score + 5
    
#Rule 2
if lowercase:
    score = score + 1
    
#Rule 3
if lowercase and uppercase:
    score = score + 5
    
#(iv) - Rule 4
if uppercase:
    score = score + 2
    
#(v) - Rule 5
if digit:
    score = score + 5
    
#Display the score
print("Score:", score) #(ii)
